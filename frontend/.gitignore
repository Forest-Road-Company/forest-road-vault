# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example is placeholders only and is the documented variable list the README points
# at. Without this negation it is untracked, so it never reaches the public repository and
# the README references a file that is not there.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
