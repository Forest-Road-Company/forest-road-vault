# Forest Road Vault — frontend build configuration.
#
# Placeholders only. Never commit a real .env.
#
# Every NEXT_PUBLIC_* value is compiled into the browser bundle and is therefore public by
# construction. Nothing secret belongs in this file: no signing key, no private RPC
# credential, no API key that is not intended to be world-readable.

# ── Required ────────────────────────────────────────────────────────────────
# The build refuses to select a network implicitly. Ethereum (1), Sepolia (11155111),
# or a local Sepolia fork (31337).
NEXT_PUBLIC_CHAIN_ID=11155111

# A public RPC endpoint. This is shipped to the browser, so use an endpoint whose key is
# safe to expose and origin-restricted — not a privileged archive credential.
NEXT_PUBLIC_RPC_URL=https://sepolia.example-rpc.invalid/YOUR_PUBLIC_KEY_HERE

# Server-only archive RPC used by /api/transparency/history. Required for mainnet and
# deliberately not prefixed NEXT_PUBLIC_: its credential must never enter the browser bundle.
# The release gate verifies chain 1 and an archive eth_getLogs request before building.
ETHEREUM_ARCHIVE_RPC_URL=https://eth-mainnet.example-rpc.invalid/YOUR_SERVER_KEY_HERE

# First block of the deployment, used as the lower bound for log queries.
NEXT_PUBLIC_PROTOCOL_DEPLOYMENT_BLOCK=11386371

# ── Optional ────────────────────────────────────────────────────────────────
# A dedicated Reown (WalletConnect) project ID enables QR and mobile deep-link sessions.
# Intentionally browser-visible and not a signing secret, but protect it with Reown's
# production/preview origin allowlist. The release gate requires the two custom-domain origins
# and https://forest-road-vault.vercel.app. Leave empty to disable WalletConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional comma-separated additional exact origins for a separately named deployment. Dynamic
# preview hosts should be listed explicitly; do not allow every project under *.vercel.app.
NEXT_PUBLIC_WALLETCONNECT_REQUIRED_ORIGINS=

# ── Address overrides ───────────────────────────────────────────────────────
# Sepolia has committed defaults in src/config/contracts.ts, so these are not needed for a
# testnet build. A mainnet build has no address fallback: every module below must be
# supplied, so that a promotion cannot silently point a mainnet-labelled UI at Sepolia or
# at a partial deployment. Supplying NEXT_PUBLIC_SUSDFR_ADDRESS makes its ABI version
# mandatory too.
#
# NEXT_PUBLIC_SUSDFR_FEE_ABI_VERSION=1
# NEXT_PUBLIC_USDFR_ADDRESS=0x...
# NEXT_PUBLIC_SUSDFR_ADDRESS=0x...
# NEXT_PUBLIC_COMPLIANCE_REGISTRY_ADDRESS=0x...
# NEXT_PUBLIC_USDC_ADDRESS=0x...
# NEXT_PUBLIC_MINT_REDEEM_CONTROLLER_ADDRESS=0x...
# NEXT_PUBLIC_RESERVE_MANAGER_ADDRESS=0x...
# NEXT_PUBLIC_REDEMPTION_QUEUE_ADDRESS=0x...
# NEXT_PUBLIC_CLAIM_BRIDGE_ADDRESS=0x...
# NEXT_PUBLIC_COLLATERAL_REGISTRY_ADDRESS=0x...
# NEXT_PUBLIC_CURATOR_MODULE_ADDRESS=0x...
# NEXT_PUBLIC_WATERFALL_ENGINE_ADDRESS=0x...
# NEXT_PUBLIC_DEFAULT_MANAGER_ADDRESS=0x...
# NEXT_PUBLIC_ASSESSED_IMPAIRMENT_SOURCE_ADDRESS=0x...
# NEXT_PUBLIC_ATTESTATION_ORACLE_ADDRESS=0x...
# NEXT_PUBLIC_POINTS_MODULE_ADDRESS=0x...
# NEXT_PUBLIC_GROVE_ADDRESS=0x...
# NEXT_PUBLIC_SGROVE_ADDRESS=0x...
# NEXT_PUBLIC_GROVE_VOTES_AGGREGATOR_ADDRESS=0x...
# NEXT_PUBLIC_GOVERNOR_ADDRESS=0x...
# NEXT_PUBLIC_TIMELOCK_ADDRESS=0x...

# ── Mainnet-only build gates ────────────────────────────────────────────────
# A mainnet build additionally requires the independently approved deployment receipt and
# manifest digest, so a production UI cannot be built without naming what it was approved
# against.
#
# NEXT_PUBLIC_MAINNET_DEPLOYMENT_HASH=0x...
# NEXT_PUBLIC_MAINNET_MANIFEST_SHA256=<64 lowercase hex characters>

# ── Curator subscription vault (Solana), /curators ───────────────────────────
# All three must be set for the wallet surface to render; leave them unset to publish the page
# without it. mainnet-beta builds are refused unless the program id matches
# solana/curator-vault/deployments/mainnet-beta.json and the mint is canonical USDC.
# NEXT_PUBLIC_CURATOR_VAULT_CLUSTER=devnet
# NEXT_PUBLIC_CURATOR_VAULT_PROGRAM_ID=
# NEXT_PUBLIC_CURATOR_VAULT_MINT=
# Optional dedicated RPC endpoint (public endpoints rate-limit the position reads):
# NEXT_PUBLIC_SOLANA_RPC_URL=
# The register-interest route (server only): Vercel Blob token provisioned by the store, and a
# random secret that keys the per-address prefix.
# BLOB_READ_WRITE_TOKEN=
# CURATOR_INTEREST_KEY_SECRET=
# Vercel Cron authenticates the bounded cleanup of expired admission-gate objects:
# CRON_SECRET=
