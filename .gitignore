# ── Secrets — NEVER commit ────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.mnemonic
**/secrets/
# Key material directory (audit L-03): the commit-guard only flags LABELED secrets,
# so ignore the whole dir to stop raw key files (deployer/attester keys) being committed.
keys/
**/keys/

# ── Foundry ───────────────────────────────────────────────────────────
contracts/cache/
contracts/out/
# Slot-isolated build dirs. Parallel review agents each need their own
# FOUNDRY_OUT/FOUNDRY_CACHE_PATH or they corrupt each other's artifacts, which
# produces `contracts/out-<slot>` / `contracts/cache-<slot>` siblings the two
# rules above do NOT cover — a `git add -A` would otherwise stage hundreds of MB
# of build output. Flagged by the 2026-07-21 pre-commit audit sweep.
contracts/out-*/
contracts/cache-*/
# broadcast logs can contain sensitive data; keep testnet run manifests
# only via the deployment manifest committed deliberately in docs/deployments/
contracts/broadcast/

# ── Node / Next.js ────────────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/.vercel/
frontend/playwright-report/
frontend/test-results/
.vercel/
*.tsbuildinfo

# ── OS / editor ───────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/

# ── Python ────────────────────────────────────────────────────────────
**/__pycache__/
*.pyc

# ── Generated pitch deliverables (regenerate from tools/generate_*.py) ──
# PDFs / PPTX / PNG decks + slide previews are generated artifacts and
# large binaries (CLAUDE.md §4.3). The reproducible source is tools/*.py.
pitch-materials/

# ── Logs / misc ───────────────────────────────────────────────────────
*.log
coverage/
lcov.info
contracts/deployments/31337.json

# Agent worktrees created by orchestration runs (never source of truth)
.claude/worktrees/
# Regenerable static-analysis output
contracts/slither-report.json
# Project-local Slither virtualenv, created 2026-09-10. STATE.md had recorded the baseline as
# impossible to regenerate here because `slither` was not installed; it is now installed locally at
# the version CI pins (0.11.5, which MUST match `slitherVersion` in contracts/slither-baseline.json)
# and the gate can be run before pushing instead of being discovered red in CI. Never committed.
#   PATH="$PWD/.venv-slither/bin:$PATH" node tools/run-slither-analysis.mjs slither.json
# The PATH prefix is load-bearing: the runner shells out to a bare `slither`.
.venv-slither/
# The RAW report is regenerable JSON and is NOT tracked; only the triaged baseline fingerprint is.
slither.json

# Internal adversarial-audit workspace and temporary Foundry links are local evidence.
# Public audit summaries live under frontend/src/content; do not commit raw logs or PoCs.
# Root-anchored deliberately: an unanchored `audit/` matches a directory of that name at ANY
# depth, which silently swallowed frontend/src/app/docs/audit/ — the renderer for the public
# audit register. Its files were already tracked so nothing was lost, but a new page added
# there would never have been committed, and would have been missing from the public repo.
/audit/
contracts/test/audit-invariant
contracts/test/audit-poc
contracts/test/audit-tools

# Generated: mtm-keeper TypeScript build output (CLAUDE.md 4.3 — no generated artifacts)
mtm-keeper/dist/
# Generated: production MTM feed TypeScript build output
mtm-feed/dist/
keeper-receivers/dist/
# Added by `vercel link`. Keep .vercel ignored: it holds project ids and the pulled
# environment, including the deployment's real secrets.
.vercel
.env*
# ...but CLAUDE.md §0.3 REQUIRES the placeholder templates to be committed. They are
# currently tracked, so `.env*` does not affect them — this negation is what keeps that
# true if either file is ever deleted and re-added.
!.env.example
!frontend/.env.example

# Fork-test output. It is written by MainnetDeploymentFork during a run and, left behind, the
# deploy script's overwrite guard then refuses to rewrite it so the next run asserts against a
# stale manifest. It also counts toward .security-audit/CURRENT_UNAUDITED_SOURCE_HASHES.sha256,
# which counts untracked files, so a leftover reds the source-identity gate.
contracts/deployments/mainnet-fork-rehearsal.test.json
# Adversarial-round scratch reproductions. Round-seven agents write here and are told to clean
# up; a `git add -A` during a live round swept two of them into 0628c6b before this existed.
contracts/test/scratch/

# Generated root Foundry cache
/cache/

# Generated BSC Foundry output
bsc/contracts/cache/
bsc/contracts/out/
